#!/bin/bash
set -u

# Regex patterns (POSIX ERE for BSD grep compatibility)
PAT_MIGRATE='prisma[[:space:]]+migrate|migrate[[:space:]]+(deploy|dev|reset|status|diff)'

# Construct URL pattern to avoid self-blocking in git diff
PAT_URL_PROTO='postgres(ql)?://'
PAT_URL="${PAT_URL_PROTO}[^[:space:]]+@"

echo "Running DB Policy Guard (pre-commit)..."

# Use a temp file to track failure
FAIL_MARKER=$(mktemp)

# 1. Scan staged files under apps/mysticos
git diff --cached --name-only -z --diff-filter=ACM -- apps/mysticos | \
while IFS= read -r -d '' f; do
  case "$f" in
    apps/mysticos/scripts/db-guard.sh|apps/mysticos/scripts/verify-db.sh) continue ;;
    *.md)
      if grep -E "$PAT_MIGRATE" "$f" >/dev/null 2>&1; then
        echo "⚠️  WARNING: prisma migrate command detected in markdown file: $f"
      fi
      continue ;;
    *)
      if grep -E "$PAT_MIGRATE" "$f" >/dev/null 2>&1; then
        echo "❌ ERROR: prisma migrate command detected in staged file: $f"
        echo "   Policy: Use 'prisma db push' for development/deployment."
        echo "fail" > "$FAIL_MARKER"
      fi
      ;;
  esac
done

# 2. Repo-wide URL check
if git diff --cached | grep -E "$PAT_URL" >/dev/null 2>&1; then
  echo "❌ ERROR: Real DATABASE_URL detected in commit diff."
  echo "   Policy: Credentials must be in .env.local only."
  echo "fail" > "$FAIL_MARKER"
fi

if [ -s "$FAIL_MARKER" ]; then
  rm -f "$FAIL_MARKER"
  exit 1
fi

rm -f "$FAIL_MARKER"
echo "✅ Pre-commit DB policy passed."
